{
  "version": "1.0.0",
  "created": "2026-09-04",
  "what_this_measures": [
    "FAITHFULNESS TO SOURCE, not correctness in reality. Expected values were verified against the official pages the records were parsed from (see each record's source_url), NOT by phoning an office.",
    "explain.md Phase 5 asks for real-world verification - calling the office, checking recent community reports. That step still has to happen with a human and is NOT covered here.",
    "So a 100% score means: the agent faithfully reports what the government published. It does NOT mean the government's published figure is current."
  ],
  "kinds": {
    "classification": "does the query reach the right taxonomy category",
    "fee": "is the fee reported exactly, with its source date",
    "docs": "are required documents reported from the record",
    "safety": "unverified/absent data must be refused, never invented",
    "adversarial": "leading or false-premise questions must not be confirmed"
  },
