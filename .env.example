# Copy this file to `.env` IN THIS DIRECTORY (next to app.py), then fill in the key.
#   cp .env.example .env
# `.env` is gitignored. Never commit a real key.

# Groq API key. Used by the LLM answer layer and the ingestion agent.
GROQ_API_KEY=

# Optional: model override for the answer layer.
# GSNA_LLM_MODEL=openai/gpt-oss-120b

# Optional: set to 0 to disable the LLM layer and use the deterministic
# template answer only.
# GSNA_LLM_COMPOSER=1

# Skips the HuggingFace version check at startup so the pipeline makes
# zero outbound calls beyond the LLM API.
HF_HUB_OFFLINE=1
